# ============================================================
# CCI Ticket Analyst — 환경 변수 설정 템플릿
# 이 파일을 복사해서 .env 파일로 저장하고, 아래 값을 채워주세요.
# cp .env.example .env
# ============================================================

# Atlassian 계정 (Jira + Confluence 공용)
ATLASSIAN_EMAIL=your_email@example.com

# Atlassian API 토큰
# 발급 방법: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Anthropic API 키 (Claude 티켓 분석용)
# 발급 방법: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# Jira 커스텀 필드 ID 설정
# 필드 ID 확인 방법: python main.py --list-fields 실행 후 확인
# ============================================================
JIRA_FIELD_COUNTRY=customfield_10100
JIRA_FIELD_BRD_STATUS=customfield_10101
JIRA_FIELD_FEATURE_TYPE=customfield_10102
