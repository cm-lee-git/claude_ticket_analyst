# ============================================================
# CCI Ticket Analyst — 환경 변수 설정 템플릿
# 이 파일을 복사해서 .env 파일로 저장하고, 아래 값을 채워주세요.
# cp .env.example .env  (Windows: copy .env.example .env)
# ============================================================

# ── Jira (hmg.atlassian.net) ────────────────────────────────
JIRA_EMAIL="your_email@example.com"
# 발급 방법: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="your_hmg_atlassian_api_token_here"

# ── Confluence (ihqdf.atlassian.net) ────────────────────────
CONFLUENCE_EMAIL="your_email@example.com"
# 발급 방법: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN="your_atlassian_api_token_here"

# ── Anthropic (Claude 분석용) ────────────────────────────────
# 발급 방법: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# 확인 방법: https://h-chat-platform.autoever.com/docs/ko/api-spec/chat-api/claude (확인 후 필요 시 아래 ANTHROPIC_BASE_URL 변경)
ANTHROPIC_BASE_URL=https://internal-apigw-kr.hmg-corp.io/hchat-in/api/v3/claude/messages

# ============================================================
# Jira 커스텀 필드 ID 설정
# 필드 ID 확인 방법: python main.py --list-fields 실행 후 확인
# ============================================================
JIRA_FIELD_COUNTRY=customfield_10100
JIRA_FIELD_BRD_STATUS=customfield_10101
JIRA_FIELD_FEATURE_TYPE=customfield_10102
